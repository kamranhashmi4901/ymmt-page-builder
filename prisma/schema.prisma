// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model YmmtUpload {
  id                  String              @id @default(cuid())
  shop                String
  fileName            String
  fileHash            String
  totalRecords        Int
  totalYears          Int
  totalMakes          Int
  totalModels         Int
  totalTrims          Int
  withTrim            Int
  withoutTrim         Int
  sourceProductHandle String?
  sourceProducts      YmmtUploadProduct[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  records YmmtRecord[]

  @@unique([shop, fileHash])
  @@index([shop])
}

model YmmtRecord {
  id           String  @id @default(cuid())
  uploadId     String
  year         String
  make         String
  model        String
  trim         String?
  warning      String?
  compatible   String?
  manufacturer String?

  selected       Boolean @default(false)
  duplicate      Boolean @default(false)
  proposedHandle String?

  upload YmmtUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([year, make, model])
}

model YmmtUploadProduct {
  id String @id @default(cuid())

  uploadId  String
  productId String?
  title     String?
  handle    String

  createdAt DateTime @default(now())

  upload YmmtUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, handle])
  @@index([uploadId])
}

model YmmtJob {
  id       String @id @default(cuid())
  shop     String
  uploadId String
  type     String @default("create")
  status   String @default("pending")

  total     Int @default(0)
  processed Int @default(0)
  created   Int @default(0)
  skipped   Int @default(0)
  failed    Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  logs YmmtJobLog[]

  @@index([shop])
  @@index([uploadId])
  @@index([status])
}

model YmmtJobLog {
  id        String   @id @default(cuid())
  jobId     String
  level     String   @default("info")
  message   String
  handle    String?
  recordId  String?
  createdAt DateTime @default(now())

  job YmmtJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model PageActionSession {
  id         String @id @default(cuid())
  shop       String
  actionType String
  status     String @default("pending")

  totalPages   Int @default(0)
  successCount Int @default(0)
  failedCount  Int @default(0)

  filterSnapshot String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  rolledBackAt   DateTime?

  changes PageChangeLog[]

  @@index([shop])
  @@index([createdAt])
}

model PageChangeLog {
  id        String @id @default(cuid())
  sessionId String

  shopifyPageId String
  handle        String
  action        String

  beforeData String?
  afterData  String?

  status       String  @default("pending")
  errorMessage String?

  createdAt    DateTime  @default(now())
  rolledBackAt DateTime?

  session PageActionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([shopifyPageId])
  @@index([handle])
}

model YmmtPageSearchJob {
  id String @id @default(cuid())

  shop   String
  status String @default("pending")

  fileName String?

  totalRecords Int @default(0)
  totalYears   Int @default(0)

  processedYears Int @default(0)

  currentYear String?

  requestCount Int @default(0)

  currentYearTotal   Int @default(0)
  currentYearFound   Int @default(0)
  currentYearMissing Int @default(0)

  pagesFound   Int @default(0)
  missingCount Int @default(0)

  progress Int @default(0)

  message String?
  error   String?

  recordsJson String

  resultPagesJson    String?
  missingRecordsJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startedAt  DateTime?
  finishedAt DateTime?

  @@index([shop, createdAt])
}
